{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Step 1: Embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step1_embeddings.py",
      "python": "${workspaceFolder}/venv/bin/python"
    },
    {
      "name": "Step 2: Similarity",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step2_similarity.py",
      "python": "${workspaceFolder}/venv/bin/python"
    },
    {
      "name": "Step 3: ChromaDB",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step3_chromadb.py",
      "python": "${workspaceFolder}/venv/bin/python"
    },
    {
      "name": "Step 4: RAG pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step4_rag.py",
      "python": "${workspaceFolder}/venv/bin/python"
    },
    {
      "name": "Step 5: Real docs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step5_real_docs.py",
      "python": "${workspaceFolder}/venv/bin/python",
      "args": ["sample.pdf"]
    },
    {
      "name": "Step 6: Persistent index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/step6_persistent.py",
      "python": "${workspaceFolder}/venv/bin/python",
      "args": ["docs"]
    },
    {
      "name": "Tests: unit only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-m", "unit", "-v"],
      "python": "${workspaceFolder}/venv/bin/python",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "python": "${workspaceFolder}/venv/bin/python",
      "cwd": "${workspaceFolder}"
    }
  ]
}
